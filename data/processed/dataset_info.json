      "store_fax": {
        "description": "fax number of the merchant",
        "pattern": "\\bFAX\\b[ \\t]*[:.]?[ \\t]*(?:NO\\.?)?[ \\t]*[:.]?[ \\t]*(\\(?\\d[\\d \\t()-]{6,}\\d)"
      },
      "store_email": {
        "description": "email address of the merchant",
        "pattern": "(?:^|:)[ \\t]*([A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)*\\.[A-Za-z]{2,})\\b"
      }
    },
