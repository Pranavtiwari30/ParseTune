!train/adapters/phi35-sroie*/adapter_config.json

# Phase 4: console logs stay local (the per-run results JSON are kept),
# except the batch-4 out-of-memory log the README cites
evaluate/results/*.log
!evaluate/results/benchmark-batch4-oom.log

